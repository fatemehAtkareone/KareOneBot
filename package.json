{
  "name": "kareone-telegram-assigner-bot",
  "version": "0.1.0",
  "private": true,
  "description": "KareOne Telegram bot for task assignment, Q&A, and team coordination. Runs on Netlify Functions.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "netlify dev",
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "tg:set-webhook": "tsx scripts/set-webhook.ts",
    "tg:delete-webhook": "tsx scripts/delete-webhook.ts",
    "tg:get-webhook": "tsx scripts/get-webhook.ts",
    "tg:set-commands": "tsx scripts/set-commands.ts",
    "tg:set-profile": "tsx scripts/set-bot-profile.ts"
  },
  "dependencies": {
    "@netlify/functions": "^2.8.2",
    "@upstash/redis": "^1.34.3",
    "drizzle-orm": "^0.36.4",
    "grammy": "^1.32.0",
    "luxon": "^3.5.0",
    "postgres": "^3.4.5",
    "rrule": "^2.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.15.0",
    "netlify-cli": "^17.38.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
