# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
TELEGRAM_BOT_USERNAME=KareOneBot

# --- Bootstrap ---
# First Telegram user_id who runs /start with this token becomes Super Admin
INSTALL_TOKEN=one-time-bootstrap-token
DEFAULT_WORKSPACE_NAME=KareOne
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_LOCALE=fa

# --- Database (Postgres: Neon, Supabase, etc.) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Redis (Upstash) for state, idempotency, rate limit ---
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# --- Public site URL (used to register the webhook) ---
PUBLIC_URL=https://kareone-bot.netlify.app

# --- Logging ---
LOG_LEVEL=info
